<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] • Warehouse Admin</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/staff-dashboard.css" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="dashboard-layout staff-dashboard">
    <!-- Sidebar -->
    <aside class="dash-sidebar light-sidebar">
        <div class="dash-brand">
            <div class="brand-icon-box">
                <i data-lucide="component"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">Precision Logistics</span>
                <span class="brand-subtitle">STAFF PORTAL</span>
            </div>
        </div>
        
        <div class="sidebar-action">
            <a href="/staff/new-sale" class="btn-orange-full" style="display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none">
                <i data-lucide="plus" style="width:16px;height:16px"></i>
                New Sale
            </a>
        </div>

        <nav class="dash-nav light-nav">
            <a href="/staff/dashboard" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="layout-dashboard"></i>
                Dashboard
            </a>
            <a href="/staff/customers" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Customers", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="users"></i>
                Customers
            </a>
            <a href="/staff/low-stock" class="dash-nav-item @(string.Equals((string)ViewContext.RouteData.Values["Action"], "LowStock", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="layers"></i>
                Inventory
            </a>
            <a href="#" class="dash-nav-item">
                <i data-lucide="shopping-bag"></i>
                Sales
            </a>
            <a href="#" class="dash-nav-item">
                <i data-lucide="bar-chart-2"></i>
                Reports
            </a>
        </nav>

        <div class="dash-sidebar-footer light-footer">
            <button type="button" class="dash-nav-item" id="staffLogoutBtn" style="background:none;border:none;width:100%;text-align:left;cursor:pointer">
                <i data-lucide="log-out"></i>
                Logout
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="dash-main">
        <!-- Header -->
        <header class="dash-header light-header">
            <div class="dash-search expand-search">
                <i data-lucide="search" style="color:var(--dash-muted);width:16px;"></i>
                <input type="text" placeholder="Find customers by vehicle #, phone, ID, or name..." />
            </div>
            
            <div class="dash-header-actions">
                <button class="dash-icon-btn" aria-label="Notifications">
                    <i data-lucide="bell"></i>
                </button>
                <button class="dash-icon-btn" aria-label="Help">
                    <i data-lucide="help-circle"></i>
                </button>
                
                <div class="user-profile">
                    <div class="user-text">
                        <span class="user-name" id="staffUserName">—</span>
                        <span class="user-role" id="staffUserRole">STAFF</span>
                    </div>
                    <img id="staffAvatar" src="https://ui-avatars.com/api/?name=User&background=0D8ABC&color=fff&rounded=true" alt="User Avatar" />
                </div>
            </div>
        </header>

        <!-- Dynamic Content -->
        <main class="dash-content bg-gray">
            @RenderBody()
        </main>
    </div>

    <!-- Initialize Lucide Icons -->
    <script src="~/js/site.js"></script>
    <script src="~/js/api-client.js"></script>
    <script>
        lucide.createIcons();

        document.addEventListener("DOMContentLoaded", () => {
            // Show current signed-in staff/admin in header (JWT stored in localStorage)
            try {
                const nameEl = document.getElementById("staffUserName");
                const roleEl = document.getElementById("staffUserRole");
                const avatarEl = document.getElementById("staffAvatar");

                const displayName = (window.VM?.getUserDisplayName?.() || "").trim();
                const role = (window.VM?.getUserRole?.() || "Staff").trim().toUpperCase();

                if (nameEl) nameEl.textContent = displayName || "User";
                if (roleEl) roleEl.textContent = role || "STAFF";
                if (avatarEl) {
                    const n = encodeURIComponent(displayName || "User");
                    avatarEl.src = `https://ui-avatars.com/api/?name=${n}&background=0D8ABC&color=fff&rounded=true`;
                }
            } catch {}

            const btn = document.getElementById("staffLogoutBtn");
            if (!btn) return;
            btn.addEventListener("click", () => {
                try { window.VM?.clearAuth?.(); } catch {}
                try {
                    localStorage.removeItem("vm_token");
                    localStorage.removeItem("vm_email");
                    localStorage.removeItem("vm_display_name");
                } catch {}
                window.location.href = "/login";
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
