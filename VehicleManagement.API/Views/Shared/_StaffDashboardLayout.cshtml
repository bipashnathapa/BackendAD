@{
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] • Staff Portal</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/staff-dashboard.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="dashboard-layout staff-dashboard">
    <aside class="dash-sidebar dark-sidebar">
        <div class="dash-brand">
            <div class="brand-icon-box">
                <i data-lucide="wrench"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">VehicleMgmt</span>
                <span class="brand-subtitle">STAFF PORTAL</span>
            </div>
        </div>

        <div class="sidebar-action">
            <a href="/staff/new-sale" class="btn-orange-full" style="display:flex;align-items:center;justify-content:center;gap:8px;text-decoration:none">
                <i data-lucide="plus" style="width:16px;height:16px"></i>
                New Sale
            </a>
        </div>

        <nav class="dash-nav dark-nav">
            <a href="/staff/dashboard" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="layout-dashboard"></i>
                Dashboard
            </a>
            <a href="/staff/new-sale" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "NewSale", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="package"></i>
                New Sale
            </a>
            <a href="/staff" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="users"></i>
                Customers
            </a>
            <a href="/staff/service-requests" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "ServiceRequests", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="clipboard-list"></i>
                Service Requests
            </a>
            <a href="/staff/low-stock" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "LowStock", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="layers"></i>
                Inventory
            </a>
            <a href="/staff/reports" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Reports", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="bar-chart-2"></i>
                Reports
            </a>
        </nav>

        <div class="dash-sidebar-footer dark-footer">
            <button type="button" class="dash-nav-item" id="staffLogoutBtn" style="background:none;border:none;width:100%;text-align:left;cursor:pointer">
                <i data-lucide="log-out"></i>
                Logout
            </button>
        </div>
    </aside>

    <div class="dash-main">
        <header class="dash-header light-header">
            <div class="dash-header-actions">
                <div class="user-profile">
                    <div class="user-text">
                        <span class="user-name" id="staffUserName">User</span>
                        <span class="user-role" id="staffUserRole">STAFF</span>
                    </div>
                    <img id="staffAvatar" src="https://ui-avatars.com/api/?name=User&background=0D8ABC&color=fff&rounded=true" alt="User Avatar" />
                </div>
            </div>
        </header>

        <main class="dash-content bg-gray">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/site.js"></script>
    <script src="~/js/api-client.js"></script>
    <script>
        lucide.createIcons();

        document.addEventListener("DOMContentLoaded", () => {
            const displayName = (window.VM?.getUserDisplayName?.() || "").trim() || "User";
            const role = (window.VM?.getUserRole?.() || "").trim() || "Staff";
            const userNameEl = document.getElementById("staffUserName");
            const userRoleEl = document.getElementById("staffUserRole");
            const avatarEl = document.getElementById("staffAvatar");

            if (userNameEl) userNameEl.textContent = displayName;
            if (userRoleEl) userRoleEl.textContent = role.toUpperCase();
            if (avatarEl) {
                avatarEl.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(displayName)}&background=0D8ABC&color=fff&rounded=true`;
            }

            const btn = document.getElementById("staffLogoutBtn");
            if (!btn) return;
            btn.addEventListener("click", () => {
                try { window.VM?.clearAuth?.(); } catch {}
                try {
                    localStorage.removeItem("vm_token");
                    localStorage.removeItem("vm_email");
                    localStorage.removeItem("vm_display_name");
                } catch {}
                window.location.href = "/login";
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
