@{
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] • Vehicle Management Dashboard</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="dashboard-layout">
    <aside class="dash-sidebar">
        <div class="dash-brand">
            <i data-lucide="car"></i>
            <span>VehicleMgmt</span>
        </div>

        <div class="dash-user-info">
            <h3 id="dashUserName">—</h3>
            <p id="dashUserMeta">Member</p>
        </div>

        <nav class="dash-nav">
            <a href="/customer/dashboard" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Dashboard", StringComparison.OrdinalIgnoreCase) || string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="layout-dashboard"></i>
                Dashboard
            </a>
            <a href="/customer/profile" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Profile", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="user"></i>
                Profile
            </a>
            <a href="/customer/invoices" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Invoices", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="receipt"></i>
                My Invoices
            </a>
            <a href="/customer/settings" class="dash-nav-item @(string.Equals(ViewContext.RouteData.Values["Action"]?.ToString(), "Settings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i data-lucide="settings"></i>
                Settings
            </a>
            <a href="/" class="dash-nav-item">
                <i data-lucide="home"></i>
                Back to Site
            </a>
        </nav>

        <div class="dash-sidebar-footer">
            <button class="dash-btn-primary" id="dashLogoutBtn" type="button">
                <i data-lucide="log-out"></i>
                Log Out
            </button>
        </div>
    </aside>

    <div class="dash-main">
        <header class="dash-header">
            <div class="dash-header-actions">
                <img id="dashAvatar" src="https://ui-avatars.com/api/?name=User&background=f97316&color=fff&rounded=true" alt="User Avatar" style="width: 36px; height: 36px; border-radius: 50%;" />
            </div>
        </header>

        <main class="dash-content">
            @RenderBody()
        </main>
    </div>

    <script>
        lucide.createIcons();
    </script>
    <script src="~/js/site.js"></script>
    <script src="~/js/api-client.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const btn = document.getElementById("dashLogoutBtn");
            if (!btn || !window.VM) return;
            btn.addEventListener("click", () => {
                window.VM.clearAuth();
                window.location.href = "/login";
            });

            const nameEl = document.getElementById("dashUserName");
            const metaEl = document.getElementById("dashUserMeta");
            const avatarEl = document.getElementById("dashAvatar");

            const displayName = (window.VM.getUserDisplayName?.() || "").trim() || "User";
            const role = (window.VM.getUserRole?.() || "").trim() || "Customer";

            if (nameEl) nameEl.textContent = displayName;
            if (metaEl) metaEl.textContent = role;
            if (avatarEl) {
                avatarEl.src = `https://ui-avatars.com/api/?name=${encodeURIComponent(displayName)}&background=f97316&color=fff&rounded=true`;
            }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
