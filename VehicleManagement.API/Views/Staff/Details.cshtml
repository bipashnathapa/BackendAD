@model Vehicle.Application.DTOs.StaffCustomerDetailsDto
@{
    ViewData["Title"] = $"Customer: {Model.FullName}";
    Layout = "_StaffDashboardLayout";
}

<div class="customer-details-container" style="max-width: 1200px; margin: 0 auto;">
    <!-- Breadcrumbs -->
    <div style="margin-bottom: 20px;">
        <a href="/staff/customers" style="color: var(--txt-orange); text-decoration: none; font-size: 14px; display: flex; align-items: center; gap: 4px;">
            <i data-lucide="arrow-left" style="width:16px;"></i>
            Back to Directory
        </a>
    </div>

    <!-- Header Section -->
    <div class="dash-card" style="padding: 24px; margin-bottom: 24px; border-radius: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div style="display: flex; gap: 20px; align-items: center;">
                <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--bg-orange-light); display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 800; color: var(--txt-orange);">
                    @Model.FullName[0]
                </div>
                <div>
                    <h1 style="margin: 0; font-size: 28px; font-weight: 800; color: #111827;">@Model.FullName</h1>
                    <div style="display: flex; gap: 16px; margin-top: 8px; color: #6b7280; font-size: 14px;">
                        <span>ID: @Model.CustomerId</span>
                        <span>@Model.Email</span>
                        <span>@(Model.PhoneNumber ?? "No Phone")</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px;">
        <!-- Left Column: Personal Info & Vehicles -->
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Address Card -->
            <div class="dash-card" style="padding: 20px; border-radius: 12px;">
                <h3 style="margin: 0 0 16px; font-size: 16px; font-weight: 700; color: #111827;">
                    Contact Address
                </h3>
                <p style="margin: 0; color: #4b5563; line-height: 1.5; font-size: 14px;">
                    @(Model.Address ?? "No address provided.")
                </p>
            </div>

            <!-- Vehicles Card -->
            <div class="dash-card" style="padding: 20px; border-radius: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: #111827;">
                        Registered Vehicles
                    </h3>
                    <span style="background: var(--bg-orange-light); color: var(--txt-orange); font-size: 12px; padding: 2px 8px; border-radius: 10px; font-weight: 600;">@Model.Vehicles.Count</span>
                </div>

                @if (Model.Vehicles.Any())
                {
                    <div style="display: flex; flex-direction: column; gap: 12px;">
                        @foreach (var v in Model.Vehicles)
                        {
                            <div style="padding: 12px; border: 1px solid #e5e7eb; border-radius: 8px; display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <strong style="display: block; font-size: 14px; color: #111827;">@v.Brand @v.Model</strong>
                                    <span style="font-size: 12px; color: #6b7280;">Plate: @v.VehicleNo</span>
                                </div>
                                <span style="font-size: 11px; background: #f3f4f6; padding: 2px 6px; border-radius: 4px; color: #374151; font-weight: 500;">@v.Type</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="text-align: center; color: #9ca3af; font-size: 14px; padding: 20px 0;">No vehicles registered.</p>
                }
            </div>
        </div>

        <!-- Right Column: Service History -->
        <div class="dash-card" style="padding: 24px; border-radius: 12px; min-height: 400px;">
            <h3 style="margin: 0 0 20px; font-size: 18px; font-weight: 700; color: #111827;">
                Service & Visit History
            </h3>

            <table class="directory-table">
                <thead>
                    <tr>
                        <th>DATE</th>
                        <th>SERVICE TYPE</th>
                        <th>VEHICLE</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Appointments.Any())
                    {
                        foreach (var app in Model.Appointments)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <strong style="font-size: 13px; color: #111827;">@app.AppointmentDate.ToString("MMM dd, yyyy")</strong>
                                        <span style="font-size: 11px; color: #6b7280;">@app.AppointmentDate.ToString("hh:mm tt")</span>
                                    </div>
                                </td>
                                <td style="font-size: 13px; color: #374151; font-weight: 600;">@app.ServiceType</td>
                                <td>
                                    <div style="display: flex; flex-direction: column;">
                                        <span style="font-size: 13px; color: #111827;">@app.VehicleInfo</span>
                                        <span style="font-size: 11px; color: #6b7280;">@app.PlateNumber</span>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = app.Status.ToLower() switch {
                                            "completed" => "badge-green",
                                            "pending" => "badge-yellow",
                                            "cancelled" => "badge-red",
                                            _ => "badge-blue"
                                        };
                                    }
                                    <span class="@badgeClass" style="font-size: 10px; padding: 2px 8px;">@app.Status.ToUpper()</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 60px; color: #9ca3af;">
                                <p style="margin: 0;">No service history found for this customer.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .customer-details-container {
        padding: 20px;
    }
    .badge-yellow {
        background: #fefce8;
        color: #854d0e;
        border: 1px solid #fef08a;
    }
</style>
