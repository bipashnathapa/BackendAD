@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "_StaffDashboardLayout";
}

<div class="staff-header-actions">
    <p class="sys-healthy">Quick access to the tools you’re using today.</p>
    <div class="header-btns">
        <a href="/staff/register" class="btn-outline-dark">
            <i data-lucide="user-plus" style="width:16px;"></i>
            Register New Customer
        </a>
        <a href="/staff/new-sale" class="btn-orange" style="text-decoration:none;display:inline-flex;align-items:center;gap:8px">
            <i data-lucide="shopping-cart" style="width:16px;"></i>
            New Sale
        </a>
    </div>
</div>

<div class="staff-main-grid">
    <div class="staff-left-col">
        <div class="dash-card">
            <div class="card-hd-flex">
                <h3>Low Stock Parts</h3>
                <a href="/staff/low-stock" class="view-all-link">OPEN INVENTORY</a>
            </div>
            <table class="staff-table">
                <thead>
                <tr>
                    <th>PART</th>
                    <th>CODE</th>
                    <th>STOCK</th>
                    <th>THRESHOLD</th>
                    <th>VENDOR</th>
                </tr>
                </thead>
                <tbody id="lowStockBody">
                <tr><td colspan="5" class="txt-muted">Loading…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="staff-right-col">
        <div class="dash-card">
            <div class="card-hd-title">
                <h3>Top Spenders</h3>
            </div>
            <div id="topSpendersList" class="txt-muted">Loading…</div>
            <div style="height:10px"></div>
            <a class="btn-outline-dark" href="/staff/reports" style="text-decoration:none;display:inline-flex;align-items:center;gap:8px">
                <i data-lucide="bar-chart-2" style="width:16px;"></i>
                Open Reports
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const token = localStorage.getItem("vm_token") || "";
            if (!token) { window.location.href = "/login"; return; }
            const role = (window.VM?.getUserRole?.() || "").toLowerCase();
            if (role && role !== "staff" && role !== "admin") { window.location.href = "/customer"; return; }

            const lowStockBody = document.getElementById("lowStockBody");
            const topSpendersList = document.getElementById("topSpendersList");

            async function loadLowStock() {
                if (!lowStockBody) return;
                try {
                    const list = await window.API.fetch("/api/parts/low-stock");
                    if (!Array.isArray(list) || list.length === 0) {
                        lowStockBody.innerHTML = `<tr><td colspan="5" class="empty">All healthy ✅</td></tr>`;
                        return;
                    }
                    lowStockBody.innerHTML = list.slice(0, 6).map(p => `
                        <tr>
                            <td><strong>${p.partName || "—"}</strong></td>
                            <td class="txt-muted">${p.partCode || "—"}</td>
                            <td><span class="badge badge-red">${p.stockQuantity ?? "—"}</span></td>
                            <td class="txt-muted">${p.lowStockThreshold ?? "—"}</td>
                            <td class="txt-muted">${p.vendorName || "—"}</td>
                        </tr>
                    `).join("");
                } catch {
                    lowStockBody.innerHTML = `<tr><td colspan="5" class="txt-muted">Couldn’t load low stock.</td></tr>`;
                }
            }

            async function loadTopSpenders() {
                if (!topSpendersList) return;
                try {
                    const list = await window.API.fetch("/api/staff/reports/high-spenders?top=5");
                    if (!Array.isArray(list) || list.length === 0) {
                        topSpendersList.textContent = "No data yet.";
                        return;
                    }
                    topSpendersList.innerHTML = list.map((c, idx) => {
                        const initials = (c.fullName || "C")
                            .split(" ")
                            .map(x => (x || "").trim().slice(0, 1))
                            .filter(Boolean)
                            .slice(0, 2)
                            .join("")
                            .toUpperCase();
                        const borderNone = idx === list.length - 1 ? "border-none" : "";
                        return `
                            <div class="list-item ${borderNone}">
                                <div class="avatar-square bg-gray-light txt-muted">${initials}</div>
                                <div class="list-details">
                                    <strong>${c.fullName || "—"}</strong>
                                    <span>${(c.invoiceCount ?? 0)} invoices</span>
                                </div>
                                <div class="list-amount">${window.API.fmtNPR(c.totalSpent)}</div>
                            </div>
                        `;
                    }).join("");
                } catch {
                    topSpendersList.textContent = "Couldn’t load top spenders.";
                }
            }

            document.addEventListener("DOMContentLoaded", () => {
                loadLowStock();
                loadTopSpenders();
            });
        })();
    </script>
}

