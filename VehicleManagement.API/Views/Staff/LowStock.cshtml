@{ ViewData["Title"]="Low Stock"; Layout="_StaffDashboardLayout"; }
<link rel="stylesheet" href="~/css/admin-dashboard.css" />
<div class="admin-dashboard">
<h1 class="dash-page-title">Low Stock</h1>
<div class="data-card">
    <table class="data-table" id="lsT"><thead><tr><th>Part</th><th>Code</th><th>Stock</th><th>Threshold</th><th>Vendor</th></tr></thead><tbody><tr><td colspan="5" class="empty">Loading…</td></tr></tbody></table>
</div>
</div>
@section Scripts {
<script>
(async () => {
    const tb = document.querySelector("#lsT tbody");
    try { const l = await API.fetch("/api/parts/low-stock"); tb.innerHTML = l.length===0?`<tr><td colspan="5" class="empty">All healthy ✅</td></tr>`:l.map(p=>`<tr><td><strong>${p.partName}</strong></td><td>${p.partCode||"—"}</td><td><span class="badge badge-red">${p.stockQuantity}</span></td><td>${p.lowStockThreshold}</td><td>${p.vendorName||"—"}</td></tr>`).join(""); }
    catch (e) { tb.innerHTML = `<tr><td colspan="5" class="empty">${e.message}</td></tr>`; }
})();
</script>
}
