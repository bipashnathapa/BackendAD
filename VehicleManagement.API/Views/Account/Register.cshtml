@{
    ViewData["Title"] = "Register";
    ViewData["BodyClass"] = "auth";
}

<div class="auth-card">
    <h1 class="auth-title">CREATE ACCOUNT</h1>
    <div class="auth-rule" aria-hidden="true"></div>

    <form id="registerForm" class="form one">
        <div class="field">
            <label for="fullName">Full name</label>
            <div class="control">
                <input id="fullName" type="text" autocomplete="name" required placeholder="Full name" style="padding-left:12px" />
            </div>
        </div>
        <div class="field">
            <label for="email">Email</label>
            <div class="control">
                <input id="email" type="email" autocomplete="email" required placeholder="you@example.com" style="padding-left:12px" />
            </div>
        </div>
        <div class="field">
            <label for="password">Password</label>
            <div class="control">
                <input id="password" type="password" autocomplete="new-password" required minlength="6" placeholder="Password" style="padding-left:12px" />
            </div>
        </div>
        <div class="field">
            <label for="userRole">Account type</label>
            <div class="control">
                <select id="userRole" required style="padding-left:12px">
                    <option value="Customer">Customer</option>
                    <option value="Staff">Staff</option>
                </select>
            </div>
        </div>
        <div class="field">
            <label for="address">Address</label>
            <div class="control">
                <input id="address" type="text" autocomplete="street-address" required placeholder="Address" style="padding-left:12px" />
            </div>
        </div>
        <div class="field" id="otpField" style="display:none;">
            <label for="otpCode">OTP code</label>
            <div class="control">
                <input id="otpCode" type="text" inputmode="numeric" maxlength="6" placeholder="Enter 6-digit code" style="padding-left:12px" />
            </div>
        </div>

        <div class="actions">
            <button class="btn primary" id="registerSubmit" type="submit" style="width:100%;">SEND OTP</button>
        </div>
        <div class="actions" style="justify-content:center;margin-top:12px;">
            <a href="/login" class="nav-link">Already have an account?</a>
        </div>
    </form>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>
</div>

@section Scripts {
    <script>
        window.VM.wireNav();
        let pendingRegistrationEmail = "";

        document.getElementById("registerForm").addEventListener("submit", async (e) => {
            e.preventDefault();
            const otpField = document.getElementById("otpField");
            const registerSubmit = document.getElementById("registerSubmit");

            if (otpField.style.display !== "none") {
                const otpCode = document.getElementById("otpCode").value.trim();
                if (!pendingRegistrationEmail || otpCode.length !== 6) return;

                try {
                    const data = await window.VM.apiJson("/api/Auth/register/verify-otp", {
                        method: "POST",
                        body: JSON.stringify({ email: pendingRegistrationEmail, otpCode }),
                    });
                    window.VM.showToast("ok", data.message || "Registration successful");
                    setTimeout(() => window.location.href = "/login", 600);
                } catch (err) {
                    window.VM.showToast("bad", err.message || "OTP verification failed");
                }

                return;
            }

            const fullName = document.getElementById("fullName").value.trim();
            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value;
            const address = document.getElementById("address").value.trim();
            const userRole = document.getElementById("userRole").value;
            if (!fullName || !email || !password || !address || !userRole) return;

            try {
                const data = await window.VM.apiJson("/api/Auth/register/request-otp", {
                    method: "POST",
                    body: JSON.stringify({ fullName, email, password, address, userRole }),
                });
                pendingRegistrationEmail = email;
                otpField.style.display = "";
                registerSubmit.textContent = "VERIFY OTP";
                window.VM.showToast("ok", data.message || "OTP sent");
            } catch (err) {
                window.VM.showToast("bad", err.message || "Registration failed");
            }
        });
    </script>
}
