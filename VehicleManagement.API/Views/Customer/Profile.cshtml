@{
    ViewData["Title"] = "My Profile";
    Layout = "_DashboardLayout";
}

<div class="dash-page-header">
    <h1>My Profile</h1>
    <p>Update your personal information.</p>
</div>

<div id="toast" class="dash-toast" role="status" aria-live="polite"></div>

<div class="dash-grid">
    <div class="dash-main-col">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3>Personal Information</h3>
                <p>Keep your details up to date.</p>
            </div>
            <div class="dash-card-body">
                <form id="profileForm" class="dash-form">
                    <div class="dash-form-row">
                        <div class="dash-field">
                            <label for="fullName">Full name</label>
                            <input id="fullName" type="text" required />
                        </div>
                        <div class="dash-field">
                            <label for="email">Email</label>
                            <input id="email" type="email" disabled autocomplete="off" />
                        </div>
                    </div>
                    <div class="dash-form-row">
                        <div class="dash-field">
                            <label for="phoneNumber">Phone</label>
                            <input id="phoneNumber" type="tel" />
                        </div>
                        <div class="dash-field">
                            <label for="dob">Date of birth</label>
                            <input id="dob" type="date" />
                        </div>
                    </div>
                    <div class="dash-field">
                        <label for="address">Address</label>
                        <input id="address" type="text" />
                    </div>
                    <div class="dash-actions">
                        <button class="dash-btn-primary" type="submit">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="dash-side-col">
        <div class="dash-card">
            <div class="dash-card-header">
                <h3>Account</h3>
                <p>Signed in details.</p>
            </div>
            <div class="dash-card-body">
                <div class="dash-strong" id="profileName">—</div>
                <div class="dash-sub" id="profileEmail">—</div>
                <div style="height:10px"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = localStorage.getItem(window.VM?.storageKeys?.token || "vm_token") || "";
        const role = (window.VM?.getUserRole?.() || "").toLowerCase();
        if (!token) window.location.href = "/login";
        if (role === "staff") window.location.href = "/staff";

        const el = (id) => document.getElementById(id);

        function toDateInputValue(dobIso) {
            if (!dobIso) return "";
            try {
                const d = new Date(dobIso);
                // convert to yyyy-mm-dd
                const y = d.getUTCFullYear();
                const m = String(d.getUTCMonth() + 1).padStart(2, "0");
                const day = String(d.getUTCDate()).padStart(2, "0");
                return `${y}-${m}-${day}`;
            } catch {
                return "";
            }
        }

        async function loadProfile() {
            const p = await window.VM.apiJson("/api/customer/profile");
            el("fullName").value = p.fullName || "";
            el("email").value = p.email || "";
            el("phoneNumber").value = p.phoneNumber || "";
            el("address").value = p.address || "";
            el("dob").value = toDateInputValue(p.dob);
            el("profileName").textContent = p.fullName || "—";
            el("profileEmail").textContent = p.email || "—";
        }

        document.addEventListener("DOMContentLoaded", async () => {
            try {
                await loadProfile();
            } catch (err) {
                window.VM.showToast("bad", err.message || "Failed to load profile");
            }

            el("profileForm").addEventListener("submit", async (e) => {
                e.preventDefault();
                const payload = {
                    fullName: el("fullName").value.trim(),
                    phoneNumber: el("phoneNumber").value.trim() || null,
                    address: el("address").value.trim() || null,
                    dob: el("dob").value ? new Date(el("dob").value + "T00:00:00Z").toISOString() : null
                };

                try {
                    const res = await window.VM.apiJson("/api/customer/profile", {
                        method: "PUT",
                        body: JSON.stringify(payload)
                    });
                    try {
                        localStorage.setItem(window.VM?.storageKeys?.displayName || "vm_display_name", payload.fullName);
                    } catch {
                        // ignore storage errors
                    }
                    window.VM.showToast("ok", res.message || "Profile updated");
                    await loadProfile();
                } catch (err) {
                    window.VM.showToast("bad", err.message || "Update failed");
                }
            });
        });
    </script>
}
