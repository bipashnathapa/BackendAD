@{ ViewData["Title"]="Parts"; Layout="_AdminDashboardLayout"; }
<h1 class="dash-page-title">Parts &amp; Inventory</h1>
<div class="data-card">
    <div class="data-card-header"><h3>All parts</h3>
        <button class="btn btn-primary" onclick="openPM()"><i data-lucide="plus" style="width:14px;height:14px"></i> New Part</button>
    </div>
    <table class="data-table" id="pT"><thead><tr><th>Part</th><th>Code</th><th>Vendor</th><th>Price</th><th>Stock</th><th>Threshold</th></tr></thead><tbody><tr><td colspan="6" class="empty">Loading…</td></tr></tbody></table>
</div>
<div class="modal-overlay" id="pM"><div class="modal">
    <h3>New Part</h3>
    <div class="form-row"><label>Name *</label><input id="p_name" /></div>
    <div class="form-row"><label>Part Code</label><input id="p_code" /></div>
    <div class="form-row"><label>Compatibility</label><input id="p_compat" placeholder="e.g. Honda Civic 2018+" /></div>
    <div class="form-row"><label>Vendor</label><select id="p_vendor"><option value="">— None —</option></select></div>
    <div class="form-row"><label>Unit Price (NPR) *</label><input id="p_price" type="number" step="0.01" min="0" /></div>
    <div class="form-row"><label>Stock *</label><input id="p_stock" type="number" min="0" /></div>
    <div class="form-row"><label>Low Stock Threshold</label><input id="p_threshold" type="number" min="0" value="10" /></div>
    <div class="form-actions"><button class="btn btn-ghost" onclick="closePM()">Cancel</button><button class="btn btn-primary" onclick="saveP()">Save</button></div>
</div></div>
@section Scripts {
<script>
async function loadP() {
    const tb = document.querySelector("#pT tbody");
    try {
        const list = await API.fetch("/api/parts");
        tb.innerHTML = list.length === 0
            ? `<tr><td colspan="6" class="empty">No parts yet.</td></tr>`
            : list.map(p => {
                const low = p.stockQuantity < p.lowStockThreshold;
                return `<tr><td><strong>${p.partName}</strong>${p.compatibility?`<br><small style="color:#6b7280">${p.compatibility}</small>`:""}</td><td>${p.partCode||"—"}</td><td>${p.vendorName||"—"}</td><td>${API.fmtNPR(p.unitPrice)}</td><td><span class="badge ${low?"badge-red":"badge-green"}">${p.stockQuantity}</span></td><td>${p.lowStockThreshold}</td></tr>`;
            }).join("");
        lucide.createIcons();
    } catch (e) { tb.innerHTML = `<tr><td colspan="6" class="empty">${e.message}</td></tr>`; }
}
async function loadVo() {
    try {
        const v = await API.fetch("/api/admin/vendors");
        document.getElementById("p_vendor").innerHTML = '<option value="">— None —</option>' + v.filter(x=>x.isActive).map(x => `<option value="${x.vendorID}">${x.name}</option>`).join("");
    } catch {}
}
function openPM() { ["p_name","p_code","p_compat","p_price","p_stock"].forEach(id=>document.getElementById(id).value=""); document.getElementById("p_threshold").value="10"; document.getElementById("pM").classList.add("active"); }
function closePM() { document.getElementById("pM").classList.remove("active"); }
async function saveP() {
    const dto = {
        partName: document.getElementById("p_name").value.trim(),
        partCode: document.getElementById("p_code").value.trim() || null,
        compatibility: document.getElementById("p_compat").value.trim() || null,
        vendorID: document.getElementById("p_vendor").value ? parseInt(document.getElementById("p_vendor").value) : null,
        unitPrice: parseFloat(document.getElementById("p_price").value || "0"),
        stockQuantity: parseInt(document.getElementById("p_stock").value || "0"),
        lowStockThreshold: parseInt(document.getElementById("p_threshold").value || "10")
    };
    if (!dto.partName || dto.unitPrice <= 0) { API.toast("Name and price required", "error"); return; }
    try { await API.fetch("/api/parts", { method: "POST", body: JSON.stringify(dto) }); API.toast("Created"); closePM(); loadP(); }
    catch (e) { API.toast(e.message, "error"); }
}
loadVo(); loadP();
</script>
}
